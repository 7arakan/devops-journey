# 1. Берем чистую и легкую Linux-систему с уже установленным Python 3.10
FROM python:3.10-slim

# 2. Создаем рабочую папку внутри контейнера и переходим в нее
WORKDIR /app

# 3. Копируем файл зависимостей с нашего компьютера внутрь контейнера
COPY requirements.txt .

# 4. Устанавливаем библиотеку Flask прямо внутри контейнера
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем сам наш скрипт app.py внутрь контейнера
COPY app.py .

# 6. Команда, которая выполнится при старте контейнера
CMD ["python", "app.py"]
